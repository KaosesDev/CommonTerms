<Application
  x:Class="CommonTerms.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
  Exit="OnExit"
  Startup="OnStartup"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- App-level shared resources -->
                <ResourceDictionary Source="/WPF-UI-Common;component/Styles/_FontSizes.xaml" />
                <ResourceDictionary Source="/WPF-UI-Common;component/Styles/_Thickness.xaml" />
                <ResourceDictionary Source="/WPF-UI-Common;component/Styles/Button.xaml" />
                <ResourceDictionary Source="/WPF-UI-Common;component/Styles/ListView.xaml" />
                <ResourceDictionary Source="/WPF-UI-Common;component/Styles/TextBlock.xaml" />

                <!-- new shared WinUI-like controls + brushes -->
                <ResourceDictionary Source="/WPF-UI-Common;component/Styles/WinuiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>