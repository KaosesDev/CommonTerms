<Page
  x:Class="CommonTerms.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:CommonTerms.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:conv="clr-namespace:CommonTerms.Helpers"
  Title="DashboardPage"
  d:DataContext="{d:DesignInstance local:DashboardPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <conv:KeyValueToTextConverter x:Key="KeyValueToTextConverter" />
  </Page.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /> <!-- Top controls -->
      <RowDefinition Height="*" />    <!-- Content: lists and panels -->
    </Grid.RowDefinitions>

    <!-- TOP ROW: input controls laid out nicely -->
    <Border Grid.Row="0" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource AccentColorBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" /> <!-- directory + browse -->
          <ColumnDefinition Width="2*" /> <!-- browse button -->
          <ColumnDefinition Width="1.2*" /> <!-- min word length input -->
          <ColumnDefinition Width="Auto" /> <!-- min word length input -->
          <ColumnDefinition Width="Auto" /> <!-- recursive toggle -->
          <ColumnDefinition Width="Auto" /> <!-- Run button -->
        </Grid.ColumnDefinitions>

        <!-- Directory input -->
        <StackPanel Orientation="Vertical" Grid.Column="0" Margin="4" VerticalAlignment="Center">
          <TextBlock Text="Directory" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Column="1" Margin="4" VerticalAlignment="Center">
          <TextBox Text="{Binding DirectoryPath, Mode=TwoWay}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Browse -->
        <StackPanel Orientation="Vertical" Grid.Column="2" Margin="4" VerticalAlignment="Center">
          <ui:Button Content="Browse..." Command="{Binding BrowseDirectoryCommand}" Width="90" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Recursive toggle (WPF-UI) -->
        <StackPanel Orientation="Vertical" Grid.Column="3" Margin="6" VerticalAlignment="Center">
          <TextBlock Text="Recursive" FontWeight="SemiBold" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Recursive toggle (WPF-UI) -->
        <StackPanel Orientation="Vertical" Grid.Column="4" Margin="6" VerticalAlignment="Center">
          <ui:ToggleSwitch IsChecked="{Binding IsRecursive, Mode=TwoWay}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Run -->
        <StackPanel Orientation="Vertical" Grid.Column="5" Margin="4" VerticalAlignment="Center">
          <ui:Button Content="Run Analysis" Command="{Binding RunAnalysisCommand}" Width="120" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- SECOND ROW: content -->
    <Grid Grid.Row="1" Margin="6,12,6,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="1.5*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: totals, top unigrams, top bigrams, save buttons -->
      <StackPanel Grid.Column="0" Orientation="Vertical" Margin="6" VerticalAlignment="Stretch">
        <TextBlock Text="Analysis Summary" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Text="{Binding TotalFileCount, StringFormat=Total files: {0}}" FontWeight="SemiBold" Margin="0,0,0,6" />

        <GroupBox Header="Top Common Terms" Margin="0,6,0,6" Height="250">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" Margin="0,4">
              <ui:Button Content="Save" ToolTip="Save common terms" Command="{Binding SaveUnigramsCommand}" />
            </StackPanel>
            <ListView Grid.Row="1" ItemsSource="{Binding TopUnigrams}" Margin="4">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource KeyValueToTextConverter}}" />
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </GroupBox>

        <GroupBox Header="Top Common Phrases" Margin="0,6,0,6" Height="250">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" Margin="0,4">
              <ui:Button Content="Save" ToolTip="Save Common Phrases" Command="{Binding SaveBigramsCommand}" />
            </StackPanel>
            <ListView Grid.Row="1" ItemsSource="{Binding TopBigrams}" Margin="4">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource KeyValueToTextConverter}}" />
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </GroupBox>
      </StackPanel>

      <!-- RIGHT: exclude Words list with delete button and moved Save/Load StopWords -->
      <StackPanel Grid.Column="1" Margin="6">
        <!-- Moved here: Save / Load StopWords, aligned right inside the right column -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
          <TextBox Text="{Binding NewStopWord, Mode=TwoWay}" Width="180" VerticalAlignment="Center" />
          <ui:Button Content="Add" Command="{Binding AddStopWordCommand}" Margin="2,0,6,0" VerticalAlignment="Center" />
          <ui:Button Content="Save" Command="{Binding SaveStopWordsCommand}" ToolTip="Save Exclude Words" Margin="0,0,0,0" VerticalAlignment="Center" />
          <ui:Button Content="Load" Command="{Binding LoadStopWordsCommand}" ToolTip="Load Exclude Words" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Exclude Words" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <GroupBox Header="Exclude Words" Margin="0,0,0,6">
          <ListView ItemsSource="{Binding StopWords}">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="{Binding}" VerticalAlignment="Center" Grid.Column="0" />

                  <ui:Button
                    Appearance="Danger"
                    Command="{Binding DataContext.RemoveStopWordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right" >
                    <ui:Button.Content>
                      <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button.Content>
                  </ui:Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </GroupBox>

      </StackPanel>
    </Grid>
  </Grid>
</Page>